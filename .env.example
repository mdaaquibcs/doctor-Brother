# ==============================================================================
# DR. ALLCARE HEALTHCARE SOLUTIONS - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to '.env.local' in the project root:
# cp .env.example .env.local
#
# Get these credentials from your Supabase Dashboard:
# Project Settings -> API
# ==============================================================================

# Supabase Public API URL (Accessible in browser and server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anonymous API Key (Accessible in browser and server, protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Private Service Role API Key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# Used exclusively in secure server actions/routes for elevated administrative tasks
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Application Base URL (for auth redirects and notification webhooks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin access in production. For local development, run:
# node scripts/setup-admin.mjs
# Generate a password hash with the setup script, then set these server-only values.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD_HASH=scrypt:<32-character-hex-salt>:<128-character-hex-hash>
# Admin sessions require a persistent writable .local directory on a single Node server.
